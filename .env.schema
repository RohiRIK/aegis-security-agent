# .env.schema
# Varlock schema — defines which env vars are sensitive.
# Run: bunx varlock load   to verify env matches this schema.
# Run: bunx varlock scan   to scan files for leaked values.
#
# @sensitive fields: real values MUST NOT appear in the LLM context window.
# Use `bunx varlock run -- <command>` to inject values only into a subprocess.

# AWS
AWS_ACCESS_KEY_ID=         # @sensitive type=string required=false
AWS_SECRET_ACCESS_KEY=     # @sensitive type=string required=false
AWS_SESSION_TOKEN=         # @sensitive type=string required=false
AWS_REGION=                # type=string required=false default=us-east-1

# Stripe
STRIPE_SECRET_KEY=         # @sensitive type=string required=false
STRIPE_PUBLISHABLE_KEY=    # type=string required=false

# Database
DATABASE_URL=              # @sensitive type=string required=false

# GitHub
GITHUB_TOKEN=              # @sensitive type=string required=false

# OpenAI
OPENAI_API_KEY=            # @sensitive type=string required=false

# Anthropic
ANTHROPIC_API_KEY=         # @sensitive type=string required=false

# Generic secrets (extend as needed)
PRIVATE_KEY=               # @sensitive type=string required=false
SECRET_KEY=                # @sensitive type=string required=false
PASSWORD=                  # @sensitive type=string required=false
PASSWD=                    # @sensitive type=string required=false
