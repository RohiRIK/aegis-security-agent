{
  "$schema": "https://aegis.local/policy-schema/v1",
  "version": "2.0",
  "actions": {
    "read_file": {
      "default": "allow",
      "deny_patterns": [".env", "**/*.pem", "**/*.key", "**/*_rsa"]
    },
    "edit_file": {
      "default": "allow",
      "deny_patterns": [".env", "**/*.pem", "**/*.key", "**/*_rsa"]
    },
    "run_shell": {
      "default": "host",
      "high_risk_patterns": ["rm -rf /", "rm -rf /*", "DROP TABLE", "DROP DATABASE", "kubectl delete", "terraform destroy"]
    },
    "fetch_domain": {
      "default": "allow"
    },
    "use_secret": {
      "default": "deny",
      "allowed_via": "varlock"
    },
    "approve_deploy": {
      "default": "hitl",
      "hitl_timeout_seconds": 120
    }
  },
  "high_risk_patterns": [
    "rm -rf /", "rm -rf /*", "rm -rf --no-preserve-root",
    "DROP TABLE", "DROP DATABASE",
    "kubectl delete", "terraform destroy"
  ],
  "routing": {
    "host_passthrough": [".*"]
  },
  "degraded_mode": {
    "allow_host_passthrough": true,
    "block_sandbox_required": false,
    "warn_on_degraded": true
  },
  "tools": {
    "enabled": [],
    "auto_update": false
  },
  "hitl_timeout_seconds": 120
}
