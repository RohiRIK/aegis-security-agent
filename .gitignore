# Aegis Security Agent — .gitignore

# Runtime state (never commit)
.aegis/

# Secrets
.env
.env.*
!.env.schema
*.pem
*.key
*_rsa
*_rsa.pub

# Build output
dist/

# Bun
node_modules/
bun.lockb
binaries/
*.bun-build

# Workspace / editor config
.claude/
.sisyphus/
.opencode/
.cursor/

# macOS
.DS_Store
