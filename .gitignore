# Aegis Security Agent — .gitignore

# Runtime state (never commit)
.aegis/

# Secrets
.env
.env.*
!.env.schema
*.pem
*.key
*_rsa
*_rsa.pub

# Build output
dist/

# Bun
node_modules/
bun.lockb
binaries/
*.bun-build

# Workspace / editor config
.claude/
.sisyphus/
.opencode/
.cursor/

# Graphify knowledge graph output
graphify-out/

# Python artifacts (not a Python project — keep clean)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# macOS
.DS_Store
